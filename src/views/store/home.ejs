<%- include('../partials/head', { pageTitle }) %>
<body class="storefront" data-whatsapp-number="<%= whatsAppNumber %>" data-base-path="<%= basePath %>">
  <div class="store-announcement"><span>Coleção de Primavera</span><span>Frete grátis para Itapevi/SP</span><span>Combo de 3 sutiãs por R$ 99,90</span></div>

  <header class="store-header">
    <a class="brand" href="<%= basePath ? basePath + '/' : '/' %>" aria-label="Alenas Lingerie, página inicial">
      <span class="brand__name">alenas</span>
      <span class="brand__caption">LINGERIE</span>
    </a>
    <nav class="store-nav" aria-label="Navegação principal">
      <a href="#catalogo">Coleção</a>
      <a href="#como-comprar">Como comprar</a>
      <a href="#sobre">Nossa essência</a>
    </nav>
    <div class="store-header__actions">
      <a class="header-whatsapp" href="https://wa.me/<%= whatsAppNumber %>?text=<%= encodeURIComponent('Olá! Tenho uma dúvida sobre a coleção de primavera da Alenas Lingerie.') %>" target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">♡</span> Dúvidas? Fale com a gente
      </a>
      <button class="cart-open" type="button" data-open-cart aria-haspopup="dialog" aria-label="Abrir sacola">
        <svg class="cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 8h16l-1.3 12H5.3L4 8Z"></path><path d="M9 9V6a3 3 0 0 1 6 0v3"></path>
        </svg>
        <span class="cart-open__label">Sacola</span>
        <span class="cart-count" data-cart-count aria-live="polite">0</span>
      </button>
    </div>
  </header>

  <main>
    <section class="hero reveal-on-view" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow">ALENAS LINGERIE · MAIS DE 25 ANOS DE MERCADO</p>
        <h1 id="hero-title">Mais de 25 anos entregando <em>qualidade.</em></h1>
        <p>Uma história feita à mão, com cuidado em cada costura, texturas especiais e acabamento pensado para acompanhar você.</p>
        <div class="hero__actions">
          <a class="button button--dark" href="#catalogo">Conheça a coleção de primavera <span aria-hidden="true">↗</span></a>
          <button class="text-button" type="button" data-open-cart>Ver minha sacola</button>
        </div>
        <div class="craft-note">
          <span class="craft-note__icon" aria-hidden="true">✦</span>
          <span><strong>Feito com cuidado, ponto a ponto.</strong><br>Tradição artesanal há mais de 25 anos.</span>
        </div>
        <p class="hero__note">Frete grátis para Itapevi/SP · atendimento próximo pelo WhatsApp.</p>
      </div>
      <% if (products.length) { %>
        <figure class="hero__image">
          <picture>
            <% if (products[0].displayImage && products[0].fallbackImage) { %>
              <source srcset="<%= basePath %><%= products[0].displayImage %>" type="image/webp">
            <% } %>
            <img src="<%= basePath %><%= products[0].fallbackImage || products[0].image %>" alt="<%= products[0].name %>" width="<%= products[0].imageWidth || '' %>" height="<%= products[0].imageHeight || '' %>" fetchpriority="high" decoding="async">
          </picture>
          <figcaption>Um detalhe especial, escolhido por você.</figcaption>
        </figure>
      <% } %>
    </section>

    <section class="spring-promos reveal-on-view" aria-label="Ofertas da coleção de primavera">
      <article class="spring-promo spring-promo--highlight">
        <div class="spring-promo__images" aria-label="Modelos de sutiã disponíveis para o combo">
          <% promoImages.combo.forEach((product) => { %>
            <picture>
              <% if (product.displayImage && product.fallbackImage) { %>
                <source srcset="<%= basePath %><%= product.displayImage %>" type="image/webp">
              <% } %>
              <img src="<%= basePath %><%= product.fallbackImage || product.image %>" alt="<%= product.name %>" width="<%= product.imageWidth || '' %>" height="<%= product.imageHeight || '' %>" loading="lazy" decoding="async">
            </picture>
          <% }) %>
        </div>
        <div class="spring-promo__copy">
          <span class="spring-promo__seal">PRIMAVERA</span>
          <p>COMBO PARA FLORESCER</p>
          <h2>3 sutiãs por <strong>R$ 99,90</strong></h2>
          <span>3 modelos diferentes · economize R$ 35,10</span>
        </div>
      </article>
      <article class="spring-promo">
        <div class="spring-promo__images spring-promo__images--pair" aria-label="Modelos que compõem a dupla de sutiãs">
          <% promoImages.dupla.forEach((product) => { %>
            <picture>
              <% if (product.displayImage && product.fallbackImage) { %>
                <source srcset="<%= basePath %><%= product.displayImage %>" type="image/webp">
              <% } %>
              <img src="<%= basePath %><%= product.fallbackImage || product.image %>" alt="<%= product.name %>" width="<%= product.imageWidth || '' %>" height="<%= product.imageHeight || '' %>" loading="lazy" decoding="async">
            </picture>
          <% }) %>
        </div>
        <div class="spring-promo__copy">
          <span class="spring-promo__seal">2 PEÇAS</span>
          <p>DUPLA ESPECIAL</p>
          <h2>2 sutiãs por <strong>R$ 74,90</strong></h2>
          <span>Dupla de sutiãs · mesmo tamanho · P a G1</span>
        </div>
      </article>
      <article class="spring-promo">
        <div class="spring-promo__images spring-promo__images--shipping" aria-label="Peça da coleção de primavera">
          <% promoImages.frete.forEach((product) => { %>
            <picture>
              <% if (product.displayImage && product.fallbackImage) { %>
                <source srcset="<%= basePath %><%= product.displayImage %>" type="image/webp">
              <% } %>
              <img src="<%= basePath %><%= product.fallbackImage || product.image %>" alt="<%= product.name %>" width="<%= product.imageWidth || '' %>" height="<%= product.imageHeight || '' %>" loading="lazy" decoding="async">
            </picture>
          <% }) %>
        </div>
        <div class="spring-promo__copy">
          <span class="spring-promo__seal">ITAPEVI/SP</span>
          <p>CARINHO NA ENTREGA</p>
          <h2>Frete <strong>grátis</strong></h2>
          <span>Para entregas em Itapevi/SP</span>
        </div>
      </article>
    </section>

    <section class="catalog section-wrap reveal-on-view" id="catalogo" aria-labelledby="catalog-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">COLEÇÃO DE PRIMAVERA · ESCOLHA SEUS MODELOS</p>
          <h2 id="catalog-title">Encontre a sua <em>favorita.</em></h2>
        </div>
        <p>O combo Primavera reúne 3 modelos diferentes de sutiã por R$ 99,90. Duplas com 2 sutiãs custam R$ 74,90 nos tamanhos P a G1; G2 a G4 têm preço especial.</p>
      </div>

      <div class="product-grid">
        <% products.forEach((product) => { %>
          <article class="product-card" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-type="<%= product.type %>" data-product-image="<%= product.image %>" data-product-display-image="<%= product.displayImage ? basePath + product.displayImage : '' %>" data-product-fallback-image="<%= product.fallbackImage ? basePath + product.fallbackImage : '' %>" data-prices="<%= JSON.stringify(product.prices) %>">
            <div class="product-card__image">
              <picture>
                <% if (product.displayImage && product.fallbackImage) { %>
                  <source srcset="<%= basePath %><%= product.displayImage %>" type="image/webp">
                <% } %>
                <img src="<%= basePath %><%= product.fallbackImage || product.image %>" alt="<%= product.name %>" width="<%= product.imageWidth || '' %>" height="<%= product.imageHeight || '' %>" loading="lazy" decoding="async">
              </picture>
              <span class="product-card__category"><%= product.category %></span>
            </div>
            <div class="product-card__details">
              <h3><%= product.name %></h3>
              <p class="product-price" aria-live="polite">
                <span>Preço para o tamanho selecionado</span>
                <strong data-product-price></strong>
                <span class="product-price__hint">por peça · subtotal calculado na sacola</span>
              </p>
              <label class="select-label">
                Tamanho
                <select data-product-size required>
                  <% sizes[product.type].forEach((size) => { %>
                    <option value="<%= size %>"><%= size %></option>
                  <% }) %>
                </select>
              </label>
              <div class="quantity-picker">
                <span>Unidades</span>
                <div class="quantity-control" aria-label="Selecionar quantidade">
                  <button type="button" data-quantity-action="decrease" aria-label="Diminuir quantidade" disabled>−</button>
                  <output data-unit-count aria-live="polite">1</output>
                  <button type="button" data-quantity-action="increase" aria-label="Aumentar quantidade">+</button>
                </div>
              </div>
              <button class="button button--add" type="button" data-add-to-cart>Adicionar à sacola <span aria-hidden="true">+</span></button>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="how-to section-wrap reveal-on-view" id="como-comprar" aria-labelledby="how-to-title">
      <p class="eyebrow">SIMPLES E COM CARINHO</p>
      <h2 id="how-to-title">Da escolha à conversa.</h2>
      <div class="steps">
        <article><span>01</span><h3>Escolha suas peças</h3><p>Navegue pela coleção e adicione à sacola o que combina com você.</p></article>
        <article><span>02</span><h3>Confira seu pedido</h3><p>Revise tamanhos, quantidades, valores e escolha a forma de pagamento.</p></article>
        <article><span>03</span><h3>Conclua no WhatsApp</h3><p>Informe o CEP e o número da casa para calcular a entrega e enviar seu pedido.</p></article>
      </div>
    </section>

    <section class="brand-story reveal-on-view" id="sobre">
      <p class="eyebrow">MAIS DE 25 ANOS DE HISTÓRIA</p>
      <h2>O toque artesanal<br>que faz você <em>florescer.</em></h2>
      <p>Há mais de 25 anos, criamos uma relação de carinho com cada cliente. Trabalho artesanal, texturas de alta qualidade e atenção aos detalhes fazem parte de cada escolha.</p>
      <div class="brand-story__values" aria-label="Diferenciais Alenas">
        <span>Feito com cuidado</span><span>Texturas especiais</span><span>Mais de 25 anos de mercado</span>
      </div>
      <a class="button button--light" href="#catalogo">Escolher minhas peças <span aria-hidden="true">↗</span></a>
      <a class="brand-story__whatsapp" href="https://wa.me/<%= whatsAppNumber %>?text=<%= encodeURIComponent('Olá! Tenho uma dúvida sobre a coleção de primavera da Alenas Lingerie.') %>" target="_blank" rel="noopener noreferrer">♡ Dúvidas? Fale com a gente pelo WhatsApp</a>
    </section>
  </main>

  <footer class="store-footer">
    <a class="brand" href="<%= basePath ? basePath + '/' : '/' %>" aria-label="Alenas Lingerie, página inicial">
      <span class="brand__name">alenas</span>
      <span class="brand__caption">LINGERIE</span>
    </a>
    <p>Beleza, leveza e desejo — do seu jeito.</p>
    <a class="footer-whatsapp" href="https://wa.me/<%= whatsAppNumber %>?text=<%= encodeURIComponent('Olá! Tenho uma dúvida sobre a coleção de primavera da Alenas Lingerie.') %>" target="_blank" rel="noopener noreferrer">Dúvidas? Chame no WhatsApp</a>
    <span>© <%= new Date().getFullYear() %> Alenas Lingerie</span>
  </footer>

  <dialog class="cart-dialog" data-cart-dialog aria-labelledby="cart-title">
    <div class="cart-dialog__header">
      <div><p class="eyebrow">SEU PEDIDO</p><h2 id="cart-title">Minha sacola</h2></div>
      <button class="cart-close" type="button" data-close-cart aria-label="Fechar sacola">×</button>
    </div>
    <ul class="cart-items" data-cart-items></ul>
    <ul class="cart-promotions" data-promo-summary></ul>
    <p class="cart-empty" data-cart-empty>Sua sacola ainda está vazia. Escolha suas peças favoritas para começar.</p>
    <div class="cart-savings" data-cart-savings hidden></div>
    <div class="cart-total"><span>Total dos produtos</span><strong data-cart-total>R$ 0,00</strong></div>
    <label class="select-label payment-label">
      Forma de pagamento
      <select data-payment-method required>
        <option value="">Selecione como deseja pagar</option>
        <option value="PIX">PIX</option>
        <option value="Cartão de crédito">Cartão de crédito</option>
        <option value="Cartão de débito">Cartão de débito</option>
        <option value="Dinheiro">Dinheiro</option>
      </select>
    </label>
    <section class="checkout-address" aria-labelledby="address-title">
      <h3 id="address-title">Onde você quer receber?</h3>
      <p>Digite seu CEP para preencher o endereço. O CEP é consultado no ViaCEP e só será enviado à loja junto com seu pedido no WhatsApp.</p>
      <label class="select-label">
        CEP
        <input type="text" inputmode="numeric" autocomplete="postal-code" maxlength="9" placeholder="00000-000" data-cep required>
      </label>
      <p class="address-status" data-cep-status role="status" aria-live="polite">Informe seu CEP para consultar o endereço e verificar o frete grátis para Itapevi/SP.</p>
      <button class="cep-retry" type="button" data-cep-retry hidden>Consultar CEP novamente</button>
      <div class="address-fields" data-address-fields hidden>
        <label class="select-label address-fields__wide">Rua
          <input type="text" autocomplete="street-address" data-address-street readonly>
        </label>
        <label class="select-label">Bairro
          <input type="text" data-address-neighborhood readonly>
        </label>
        <div class="address-fields__city">
          <label class="select-label">Cidade
            <input type="text" autocomplete="address-level2" data-address-city readonly>
          </label>
          <label class="select-label">UF
            <input type="text" autocomplete="address-level1" data-address-state readonly>
          </label>
        </div>
        <label class="select-label">Número
          <input type="text" inputmode="numeric" autocomplete="address-line2" maxlength="12" placeholder="Número" data-address-number required>
        </label>
        <label class="select-label">Complemento <span>(opcional)</span>
          <input type="text" maxlength="80" placeholder="Apto, bloco..." data-address-complement>
        </label>
        <label class="no-number-label"><input type="checkbox" data-address-no-number> Endereço sem número</label>
      </div>
      <p class="address-privacy">Seus dados de endereço não ficam salvos no site; serão incluídos somente na mensagem do pedido.</p>
    </section>
    <% if (whatsAppNumber) { %>
      <button class="button button--dark cart-checkout" type="button" data-checkout disabled>Concluir pedido no WhatsApp <span aria-hidden="true">↗</span></button>
    <% } else { %>
      <p class="cart-config-warning">O número do WhatsApp está inválido. Confira WHATSAPP_SELLER_NUMBER no arquivo .env.</p>
      <button class="button button--dark cart-checkout" type="button" data-checkout disabled>Concluir pedido no WhatsApp <span aria-hidden="true">↗</span></button>
    <% } %>
    <p class="cart-status" data-cart-status role="status" aria-live="polite"></p>
  </dialog>

  <p class="cart-toast" data-live-status role="status" aria-live="polite" aria-hidden="true"></p>
  <script src="<%= basePath %>/js/main.js" defer></script>
</body>
</html>
